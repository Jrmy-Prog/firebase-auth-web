PORT=3000
NODE_ENV=development
TRUST_PROXY=0

# Konfigurasi publik aplikasi web Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Backend: pilih file service account ATAU email + private key.
# Jangan simpan file service account dalam public/.
GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_CLIENT_EMAIL=
# Jika memakai variabel ini, newline dapat ditulis sebagai \n.
FIREBASE_PRIVATE_KEY=